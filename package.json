{
  "name": "wetbulb-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "next dev --turbopack",
    "build": "node --no-deprecation ./node_modules/next/dist/bin/next build --turbopack",
    "postbuild": "mkdir -p .next/standalone/.next && rm -rf .next/standalone/.next/static .next/standalone/public && cp -R .next/static .next/standalone/.next/static && if [ -d public ]; then cp -R public .next/standalone/public; fi",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "start": "node .next/standalone/server.js",
    "lint": "oxlint . && eslint .",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "pnpm test && pnpm run test:db && pnpm run test:e2e",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "tsx src/testing/run-e2e.ts 'playwright test'",
    "test:e2e:ci": "tsx src/testing/run-e2e.ts playwright test",
    "test:e2e:mock": "E2E_USE_RUNTIME_MOCKS=true tsx src/testing/run-e2e.ts 'playwright test'",
    "test:e2e:prod": "tsx src/testing/run-e2e.ts 'pnpm build && PLAYWRIGHT_SERVER_MODE=production playwright test --project=chromium'",
    "test:e2e:prod:all": "tsx src/testing/run-e2e.ts 'pnpm build && PLAYWRIGHT_SERVER_MODE=production playwright test'",
    "test:e2e:critical": "pnpm run test:e2e",
    "test:e2e:critical:prod": "pnpm run test:e2e:prod",
    "test:e2e:critical:prod:all": "pnpm run test:e2e:prod:all",
    "test:unit": "vitest run --exclude='**/*.integration.test.*' --exclude='**/integration.test.*'",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "knip": "knip"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.75.3",
    "@tanstack/react-query": "^5.103.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.29.6",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mswjs/data": "^0.16.2",
    "@next/bundle-analyzer": "16.2.12",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-oxlint": "^1.85.0",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "postcss": "^8.5.28",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsc-files": "^1.1.4",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "eslint --fix",
      "oxfmt"
    ],
    "*.{ts,tsx}": [
      "tsc-files --noEmit"
    ],
    "*.{json,css,md}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@11.20.0"
}
