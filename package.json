{
  "name": "wetbulb-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node --no-deprecation ./node_modules/next/dist/bin/next build --turbopack",
    "postbuild": "mkdir -p .next/standalone/.next && rm -rf .next/standalone/.next/static .next/standalone/public && cp -R .next/static .next/standalone/.next/static && if [ -d public ]; then cp -R public .next/standalone/public; fi",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "start": "node .next/standalone/server.js",
    "lint": "oxlint . && eslint .",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "pnpm test && pnpm run test:db && pnpm run test:e2e",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "tsx src/testing/run-e2e.ts 'playwright test'",
    "test:e2e:ci": "tsx src/testing/run-e2e.ts playwright test",
    "test:e2e:mock": "E2E_USE_RUNTIME_MOCKS=true tsx src/testing/run-e2e.ts 'playwright test'",
    "test:e2e:prod": "tsx src/testing/run-e2e.ts 'pnpm build && PLAYWRIGHT_SERVER_MODE=production playwright test --project=chromium'",
    "test:e2e:prod:all": "tsx src/testing/run-e2e.ts 'pnpm build && PLAYWRIGHT_SERVER_MODE=production playwright test'",
    "test:e2e:critical": "pnpm run test:e2e",
    "test:e2e:critical:prod": "pnpm run test:e2e:prod",
    "test:e2e:critical:prod:all": "pnpm run test:e2e:prod:all",
    "test:unit": "vitest run --exclude='**/*.integration.test.*' --exclude='**/integration.test.*'",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "knip": "knip"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.65.0",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.29.3",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-map-gl": "^8.1.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mswjs/data": "^0.16.2",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testcontainers/postgresql": "^12.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^10.5.0",
    "eslint-plugin-better-tailwindcss": "^4.6.1",
    "eslint-plugin-oxlint": "^1.73.0",
    "eslint-plugin-playwright": "^2.10.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.26.0",
    "lint-staged": "^17.0.8",
    "msw": "^2.15.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "postcss": "^8.5.16",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "tsc-files": "^1.1.4",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "eslint --fix",
      "oxfmt"
    ],
    "*.{ts,tsx}": [
      "tsc-files --noEmit"
    ],
    "*.{json,css,md}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@11.11.0"
}
